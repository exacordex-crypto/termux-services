#!/bin/sh

show_help() {
    printf 'Usage:\n    sv-enable <service-name>\n\n    Enabling a service will make it autostart\n'
}

[ "${1:-}" ] || { show_help; exit 1; }
[ "${SVDIR:-}" ] || { printf 'Error: SVDIR not set\n' >&2; exit 1; }
[ -d "$SVDIR/$1" ] || { printf 'Error: service not found: %s\n' "$1" >&2; exit 1; }

rm -f "$SVDIR/$1/down"
exec sv up "$1"
