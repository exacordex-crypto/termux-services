#!/data/data/com.termux/files/usr/bin/sh

set -eu

: "${PREFIX:?PREFIX is not set}"
: "${SVDIR:?SVDIR is not set}"

NAME=service-daemon
PIDDIR=${PREFIX}/var/run
PIDFILE=${PIDDIR}/${NAME}.pid
DAEMON=${PREFIX}/bin/runsvdir
DAEMON_OPTS=${SVDIR}

start() {
    mkdir -p "$PIDDIR" "$SVDIR"
    if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        return 0
    fi
    rm -f "$PIDFILE"
    start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -d "$PREFIX" -- "$DAEMON_OPTS"
}

stop_supervise_tree() {
    for f in "$SVDIR"/*/supervise "$SVDIR"/*/log/supervise; do
        [ -d "$f" ] || continue
        if [ -s "$f/pid" ]; then
            kill -9 "$(cat "$f/pid")" 2>/dev/null || :
        fi
        rm -rf "$f"
    done
}

stop() {
    if [ -s "$PIDFILE" ]; then
        start-stop-daemon -K -s 1 -o -p "$PIDFILE" || :
        pid=$(cat "$PIDFILE" 2>/dev/null || printf '')
        if [ -n "$pid" ]; then
            tail -f --pid="$pid" /dev/null 2>/dev/null || :
        fi
        rm -f "$PIDFILE"
    fi
    stop_supervise_tree
}

case "${1:-}" in
    start)
        printf 'Starting daemon: %s' "$NAME"
        start
        printf '.\n'
        ;;
    stop)
        printf 'Stopping daemon: %s' "$NAME"
        stop
        printf '.\n'
        ;;
    restart)
        printf 'Restarting daemon: %s' "$NAME"
        stop
        start
        printf '.\n'
        ;;
    *)
        printf 'Usage: %s {start|stop|restart}\n' "$0" >&2
        exit 1
        ;;
esac
