#!/bin/sh

show_help() {
    printf 'Usage:\n    sv-disable <service-name>\n\n    Disabling a service will make it not autostart\n'
}

[ "${1:-}" ] || { show_help; exit 1; }
[ "${SVDIR:-}" ] || { printf 'Error: SVDIR not set\n' >&2; exit 1; }
[ -d "$SVDIR/$1" ] || { printf 'Error: service not found: %s\n' "$1" >&2; exit 1; }

touch "$SVDIR/$1/down"
exec sv down "$1"
